# python scripts/init_env.py creates randomized .env for local demo; never commit .env
APP_MODE=demo
DB_PATH=./data/openretail.sqlite3
ADMIN_KEY=REPLACE_WITH_RANDOM_ADMIN_KEY
INTEGRATION_KEY=REPLACE_WITH_RANDOM_INTEGRATION_KEY
APP_SECRET=REPLACE_WITH_RANDOM_SECRET
MOCK_PAYMENTS_ENABLED=true
HA_ENABLED=false
LIVE_DOOR_ENABLED=false
HA_URL=http://127.0.0.1:8123
HA_TOKEN=
HA_UNLOCK_SCRIPT=script.openretail_entry_unlock
HA_DOOR_STATE_ENTITY=binary_sensor.openretail_door_contact
FRIGATE_MQTT_ENABLED=false
FRIGATE_MQTT_HOST=127.0.0.1
FRIGATE_MQTT_PORT=1883
FRIGATE_MQTT_USER=
FRIGATE_MQTT_PASSWORD=
INTERNAL_API_URL=http://127.0.0.1:8000
ERPNEXT_URL=
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=

# V2 security: generate with scripts/set_admin_password.py before running pilot.
ADMIN_PASSWORD_HASH=
TRUSTED_PROXY_TLS=false
PUBLIC_BASE_URL=
STORE_SITE_APPROVED=false

# Payment is OFF unless a qualified merchant completes sandbox and reconciliation gate.
PAYMENT_PROVIDER=disabled
WECHAT_MCHID=
WECHAT_APPID=
WECHAT_MERCHANT_SERIAL=
WECHAT_MERCHANT_PRIVATE_KEY_FILE=
WECHAT_PLATFORM_PUBLIC_KEY_FILE=
WECHAT_PLATFORM_SERIAL=
WECHAT_API_V3_KEY=
WECHAT_NOTIFY_URL=
