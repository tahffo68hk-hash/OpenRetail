# Production profile. Mock payment cannot stand in for a sale, and the physical lock stays off.
# Fill real merchant values only on the server .env. Do not commit that file.
APP_MODE=production
DB_PATH=./data/production/openretail.sqlite3
ADMIN_KEY=REPLACE_WITH_RANDOM_ADMIN_KEY
INTEGRATION_KEY=REPLACE_WITH_RANDOM_INTEGRATION_KEY
APP_SECRET=REPLACE_WITH_RANDOM_SECRET
ADMIN_PASSWORD_HASH=REPLACE_WITH_PBKDF2_HASH
MOCK_PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=disabled
LIVE_DOOR_ENABLED=false
HA_ENABLED=false
TRUSTED_PROXY_TLS=true
PUBLIC_BASE_URL=https://shop.example.invalid
STORE_SITE_APPROVED=false
WECHAT_MCHID=
WECHAT_APPID=
WECHAT_MERCHANT_SERIAL=
WECHAT_MERCHANT_PRIVATE_KEY_FILE=
WECHAT_PLATFORM_PUBLIC_KEY_FILE=
WECHAT_PLATFORM_SERIAL=
WECHAT_API_V3_KEY=
WECHAT_NOTIFY_URL=
